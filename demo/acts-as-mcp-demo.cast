{"version": 2, "width": 80, "height": 24, "timestamp": 1786994558, "env": {"SHELL": "/bin/bash", "TERM": "linux"}, "title": "acts_as_mcp: expose:/where: + audit log, real MCP JSON-RPC"}
[0.006488, "o", "$ ruby -Ilib examples/activerecord_model.rb\r\n"]
[1.166846, "o", "# acts_as_mcp registered these tools automatically from `expose:` + `where:`:\r\n--> {\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}\r\n"]
[1.166928, "o", "<-- {\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"tools\":[{\"name\":\"article_get\",\"description\":\"Fetch one article by primary key (read-only)\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\",\"description\":\"primary key\"}},\"required\":[\"id\"]}},{\"name\":\"article_list\",\"description\":\"List article records (read-only, paginated, filterable on title)\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":100},\"offset\":{\"type\":\"integer\",\"minimum\":0},\"where\":{\"type\":\"object\",\"description\":\"Exact-match filters. Allowed keys: title.\",\"additionalProperties\":false,\"properties\":{\"title\":{\"type\":[\"string\",\"integer\",\"number\",\"boolean\",\"null\"]}}}}}}]}}\r\n\r\n# article_list - note internal_notes never appears, it was never exposed:\r\n--> {\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"article_list\",\"arguments\":{\"limit\":10}}}\r\n"]
[1.175495, "o", "<-- {\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"[{\\\"id\\\":1,\\\"title\\\":\\\"Shipping idempotent_rack\\\",\\\"body\\\":\\\"Idempotency-Key middleware for Rack.\\\"},{\\\"id\\\":2,\\\"title\\\":\\\"Shipping modelgate\\\",\\\"body\\\":\\\"A multi-provider LLM gateway.\\\"}]\"}],\"isError\":false}}\r\n\r\n# article_get for a specific id:\r\n"]
[1.175832, "o", "--> {\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"article_get\",\"arguments\":{\"id\":1}}}\r\n"]
[1.177684, "o", "<-- {\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"id\\\":1,\\\"title\\\":\\\"Shipping idempotent_rack\\\",\\\"body\\\":\\\"Idempotency-Key middleware for Rack.\\\"}\"}],\"isError\":false}}\r\n\r\n# article_get for a missing id - a real ToolError, not a 500 or a nil crash:\r\n--> {\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"article_get\",\"arguments\":{\"id\":999999}}}\r\n"]
[1.178441, "o", "<-- {\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"article 999999 not found\"}],\"isError\":true}}\r\n\r\n# article_list filtered by an allowlisted `where:` attribute (exact match):\r\n--> {\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"article_list\",\"arguments\":{\"where\":{\"title\":\"Shipping modelgate\"}}}}\r\n"]
[1.179627, "o", "<-- {\"jsonrpc\":\"2.0\",\"id\":5,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"[{\\\"id\\\":2,\\\"title\\\":\\\"Shipping modelgate\\\",\\\"body\\\":\\\"A multi-provider LLM gateway.\\\"}]\"}],\"isError\":false}}\r\n\r\n# filtering on internal_notes is rejected - it's not in where:, even though it exists:\r\n--> {\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"tools/call\",\"params\":{\"name\":\"article_list\",\"arguments\":{\"where\":{\"internal_notes\":\"unpublished draft, do not expose\"}}}}\r\n"]
[1.180245, "o", "<-- {\"jsonrpc\":\"2.0\",\"id\":6,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"where: \\\"internal_notes\\\" is not a filterable attribute (allowed: title)\"}],\"isError\":true}}\r\n\r\n# every call above was persisted by ActsAsMcp::ActiveRecordAuditSink (rails generate acts_as_mcp:audit_log for the migration) - real rows, not a mock:\r\n"]
[1.180688, "o", "  #1 tool=\"article_list\" ok=true args={\"limit\":10} duration_ms=3 error=nil\r\n  #2 tool=\"article_get\" ok=true args={\"id\":1} duration_ms=1 error=nil\r\n  #3 tool=\"article_get\" ok=false args={\"id\":999999} duration_ms=0 error=\"article 999999 not found\"\r\n"]
[1.180703, "o", "  #4 tool=\"article_list\" ok=true args={\"where\":{\"title\":\"Shipping modelgate\"}} duration_ms=0 error=nil\r\n"]
[1.1809, "o", "  #5 tool=\"article_list\" ok=false args={\"where\":{\"internal_notes\":\"unpublished draft, do not expose\"}} duration_ms=0 error=\"where: \\\"internal_notes\\\" is not a filterable attribute (allowed: title)\"\r\n"]
